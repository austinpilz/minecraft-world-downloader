<?xml version="1.0" encoding="UTF-8"?>

<?import gui.components.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="264.0" prefWidth="590.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.ProxyTabController">
    <GridPane layoutX="14.0" layoutY="6.0" prefHeight="231.0" prefWidth="560.0">
        <columnConstraints>
            <ColumnConstraints prefWidth="160.0" />
            <ColumnConstraints maxWidth="345.0" minWidth="159.0" prefWidth="200.0" />
            <ColumnConstraints maxWidth="170.0" minWidth="105.0" prefWidth="105.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints prefHeight="32.0" />
            <RowConstraints prefHeight="32.0" />
            <RowConstraints prefHeight="32.0" />
            <RowConstraints prefHeight="32.0" />
            <RowConstraints prefHeight="32.0" />
        </rowConstraints>
        <Label text="Enable SOCKS5 proxy" GridPane.rowIndex="0">
            <tooltip>
                <QuickTooltip text="Route the outbound connection to the Minecraft server through a SOCKS5 proxy. Only the game connection is affected." />
            </tooltip>
        </Label>
        <CheckBox fx:id="enabled" prefHeight="25.0" prefWidth="93.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Proxy host" GridPane.rowIndex="1" />
        <TextField fx:id="host" promptText="e.g. 127.0.0.1" prefHeight="25.0" prefWidth="93.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Proxy port" GridPane.rowIndex="2" />
        <IntField fx:id="port" prefHeight="25.0" prefWidth="93.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Username (optional)" GridPane.rowIndex="3">
            <tooltip>
                <QuickTooltip text="Leave blank if the proxy does not require authentication." />
            </tooltip>
        </Label>
        <TextField fx:id="username" promptText="Username" prefHeight="25.0" prefWidth="93.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="Password (optional)" GridPane.rowIndex="4" />
        <PasswordField fx:id="password" promptText="Password" prefHeight="25.0" prefWidth="93.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
    </GridPane>
</AnchorPane>
