<?xml version="1.0" encoding="UTF-8"?>

<?import gui.components.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="290.0" prefWidth="578.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.ProxyTabController">
    <GridPane layoutX="14.0" layoutY="6.0" prefHeight="224.0" prefWidth="540.0">
        <columnConstraints>
            <ColumnConstraints prefWidth="170.0" />
            <ColumnConstraints prefWidth="220.0" />
            <ColumnConstraints prefWidth="150.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints prefHeight="32.0" />
            <RowConstraints prefHeight="32.0" />
            <RowConstraints prefHeight="32.0" />
            <RowConstraints prefHeight="32.0" />
            <RowConstraints prefHeight="32.0" />
            <RowConstraints prefHeight="32.0" />
            <RowConstraints prefHeight="32.0" />
        </rowConstraints>

        <Label text="Use SOCKS5 proxy">
            <tooltip>
                <QuickTooltip text="Route the connection to the remote server through a SOCKS5 proxy" />
            </tooltip>
        </Label>
        <CheckBox fx:id="enableSocksProxy" GridPane.columnIndex="1" />

        <Label text="Proxy host" GridPane.rowIndex="1">
            <tooltip>
                <QuickTooltip text="Hostname or IP address of the SOCKS5 proxy, e.g. '127.0.0.1'" />
            </tooltip>
        </Label>
        <TextField fx:id="socksProxyHost" prefHeight="25.0" prefWidth="93.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Proxy port" GridPane.rowIndex="2" />
        <DefaultIntField fx:id="socksProxyPort" defaultVal="1080" prefHeight="25.0" prefWidth="93.0" text="default" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Username (optional)" GridPane.rowIndex="3">
            <tooltip>
                <QuickTooltip text="Only needed if the proxy requires authentication" />
            </tooltip>
        </Label>
        <TextField fx:id="socksProxyUsername" prefHeight="25.0" prefWidth="93.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="Password (optional)" GridPane.rowIndex="4">
            <tooltip>
                <QuickTooltip text="Not saved to the config file, re-enter it after restarting" />
            </tooltip>
        </Label>
        <PasswordField fx:id="socksProxyPassword" prefHeight="25.0" prefWidth="93.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <Label text="Skip DNS SRV lookup" GridPane.rowIndex="5">
            <tooltip>
                <QuickTooltip text="The SRV lookup that finds a server's true address uses your own DNS resolver, not the proxy. Skipping it keeps the address private, but servers that use an SRV record then need their full address and port" />
            </tooltip>
        </Label>
        <CheckBox fx:id="disableSrvLookup" GridPane.columnIndex="1" GridPane.rowIndex="5" />

        <Label text="Only the connection to the server is proxied, logging in is not." GridPane.columnSpan="3" GridPane.rowIndex="6" />
    </GridPane>
</AnchorPane>
